{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "foOom",
  "version": "0.2.0",
  "identifier": "com.foom.desktop",
  "build": {
    "frontendDist": "../../ui-react/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "bun run --cwd ../../.. prepare:desktop && bun run --cwd ../ui-react dev",
    "beforeBuildCommand": "bun run --cwd ../../.. prepare:desktop && bun run --cwd ../ui-react build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "foOom Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "resources": {
      "../../../../LICENSE": "LICENSE",
      "../../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Harsh Bhardwaj",
    "copyright": "Copyright (c) 2026 Harsh Bhardwaj. Licensed under MIT.",
    "shortDescription": "Open-source screen recorder and editor",
    "longDescription": "foOom is an open-source-first screen recorder and focused video editor. Windows is the first supported platform; macOS and Linux capture support is under development.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
