{
  "name": "foom-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop/ui-react",
    "apps/web"
  ],
  "scripts": {
    "dev": "bun --filter foom dev",
    "build": "bun --filter foom-web build",
    "preview": "bun --filter foom preview",
    "dev:desktop": "bun --filter foom dev",
    "build:desktop-ui": "bun --filter foom build",
    "preview:desktop": "bun --filter foom preview",
    "dev:web": "bun --filter foom-web dev",
    "build:web": "bun --filter foom-web build",
    "tauri": "cd apps/desktop/tauri-shell && bun x tauri",
    "build:desktop": "cmd.exe /c build_desktop.bat"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  }
}
